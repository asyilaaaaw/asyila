print("1. Diberikan sebuah bangunan dengan nilai sebagai berikut!")
print("Panjang  = 12 M")
print("Lebar    = 5 M")
print("Tinggi   = 8 M")
print("\n")

print("A. Hitung luas, volume, dan keliling dari bangunan tersebut!")
print("Jawab:")
    # Menghitung luas bangunan
hasil_luas          = Panjang * Lebar
print("Luas Bangunan     =", hasil_luas, "M^2")
    # Menghitung volume bangunan
hasil_volume        = Panjang * Lebar * Tinggi
print("Volume Bangunan   =", hasil_volume, "M^3")
    # Menghitung keliling Bangunan
hasil_keliling      = 2 * Panjang * Lebar + 2 * Panjang * Tinggi + 2 * Tinggi * Lebar 
print("Keliling Bangunan =", hasil_keliling, "M")
print("\n")

print("B. Apakah luas bangunan tersebut lebih luas dari 50?")
print("Jawab:")
    # Menggunakan operasi komperasi lebih besar dari (>)
a   = hasil_luas
    # Lebih besar dari (>)
hasil = a > 50
print("Luas bangunan > 50 =", hasil)
print("\n")

print("C. Apakah volume bangunan tersebut bernilai 480?")
print("Jawab:")
    # Menggunakan operasi komperasi sama dengan (=)
a   = hasil_volume
    # Sama dengan (==)
hasil = a == 480
print("Volume Bangunan ==", 480, "=", hasil)
print("\n")

